---
import kathiHeader from "../assets/kathi-header.png";
const headerSrc = kathiHeader.src;
---

<header id="container">
	<div class="content">
		<h1>Katharina Kreuzpointer</h1>
	</div>
	<div class="background"></div>
</header>

<style define:vars={{ headerSrc: `url(${kathiHeader.src})` }}>
	#container {
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: center;
		overflow: hidden;
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.background {
		width: 100%;
		flex: 1;
		transform: translateY(100vh);
		opacity: 0;
		background-image: var(--headerSrc);
		background-position: center bottom;
		background-size: contain;
		background-repeat: no-repeat;
		position: relative;
		bottom: -5%;
		animation:
			slideUp 2s 0.3s ease forwards,
			jiggle-2 2s 2.3s ease infinite;
	}

	h1 {
		font-size: 6rem;
		margin: 40px 0;
		animation:
			slideUp 2s ease forwards,
			jiggle-1 10s 2.3s ease infinite;
	}

	@keyframes slideUp {
		0% {
			transform: translateY(100vh);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 1;
		}
	}

	/* jiggle 2s 2.3s ease infinite */
	@keyframes jiggle-1 {
		0% {
			transform: rotate(0deg);
		}
		5% {
			transform: rotate(-3deg) scale(1.05);
		}
		10% {
			transform: rotate(0deg);
		}
		50% {
			transform: rotate(0deg);
		}
		55% {
			transform: rotate(3deg) scale(1.05);
		}
		60% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}

	@keyframes jiggle-2 {
		0% {
			transform: translateY(0);
		}
		25% {
			transform: translateY(-10px);
		}
		50% {
			transform: translateY(-10px);
		}
		75% {
			transform: translateY(0);
		}
		100% {
			transform: translateY(0);
		}
	}
</style>
